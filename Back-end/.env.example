# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/devfest_db
# Or use MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# Google Gemini AI API Key
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Configuration (optional)
# Use comma-separated list for multiple origins, or * for all
CORS_ORIGIN=http://localhost:3000

# Rate Limiting (optional)
# MAX_REQUESTS_PER_WINDOW=100

# JWT Secret (for authentication features)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# File Upload Configuration (optional)
MAX_FILE_SIZE=10485760

# Internship/Scholarship Data Sources (optional)
# Configure these URLs to fetch live data instead of mock data
# INTERNSHIPS_DATA_URL=http://your-data-source/internships.html
# SCHOLARSHIPS_DATA_URL=http://your-data-source/scholarships.html
